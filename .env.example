# Copy this file to .env and fill in local-only values.
# A local Compose project label.
COMPOSE_PROJECT_NAME=
# Image tags for the local database and Spark runtime.
POSTGRES_IMAGE=
SPARK_IMAGE=
# Internal Compose DNS name and Spark master address.
SPARK_MASTER_HOST=
SPARK_MASTER_URL=
# Local database role and database names.
POSTGRES_USER=
POSTGRES_DB=
# Unused host ports to bind to 127.0.0.1.
POSTGRES_HOST_PORT=
SPARK_MASTER_UI_HOST_PORT=
SPARK_MASTER_HOST_PORT=
SPARK_WORKER_UI_HOST_PORT=
JUPYTER_HOST_PORT=
# Worker resource limits.
SPARK_WORKER_CORES=
SPARK_WORKER_MEMORY=
# Match these to `id -u` and `id -g` for notebook file ownership.
JUPYTER_UID=
JUPYTER_GID=
# Path to the local, ignored password file.
POSTGRES_SECRET_FILE=
